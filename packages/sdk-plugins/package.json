{
  "name": "@plitzi/sdk-plugins",
  "version": "0.38.24",
  "license": "AGPL-3.0",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@plitzi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./*": {
      "@plitzi/source": "./src/*/index.ts",
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.mjs"
    }
  },
  "scripts": {
    "lint": "eslint ./src",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "build:dev": "vite build --mode development --minify false",
    "build:dev-watch": "vite build --mode development --watch --minify false",
    "build:prod": "vite build"
  },
  "type": "module",
  "sideEffects": false,
  "dependencies": {
    "@plitzi/plitzi-ui": "^1.6.36",
    "@plitzi/sdk-shared": "workspace:*"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
