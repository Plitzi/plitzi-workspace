{
  "name": "@plitzi/sdk-elements",
  "version": "0.38.17",
  "license": "AGPL-3.0",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@plitzi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./*": {
      "@plitzi/source": "./src/*/index.ts",
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.mjs"
    }
  },
  "scripts": {
    "lint": "eslint ./src",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "build:dev": "vite build --mode development --minify false",
    "build:dev-watch": "vite build --mode development --watch --minify false",
    "build:prod": "vite build"
  },
  "type": "module",
  "sideEffects": false,
  "dependencies": {
    "@dr.pogodin/react-helmet": "^3.3.2",
    "@plitzi/nexus": "^1.4.0",
    "@plitzi/plitzi-ui": "^1.6.33",
    "@plitzi/sdk-auth": "workspace:*",
    "@plitzi/sdk-event-bridge": "workspace:*",
    "@plitzi/sdk-interactions": "workspace:*",
    "@plitzi/sdk-navigation": "workspace:*",
    "@plitzi/sdk-schema": "workspace:*",
    "@plitzi/sdk-shared": "workspace:*",
    "clsx": "^2.1.1",
    "immer": "^11.1.21",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9.39.5",
    "react": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
