{
  "name": "@plitzi/sdk-shared",
  "version": "0.39.2",
  "license": "AGPL-3.0",
  "files": [
    "dist",
    "eslint.config.mjs",
    "tailwind.config.js",
    "vite.config.ts",
    "setupTests.ts"
  ],
  "exports": {
    ".": {
      "@plitzi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./*": {
      "@plitzi/source": "./src/*/index.ts",
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.mjs",
      "default": "./dist/*/index.mjs"
    }
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "lint": "eslint --cache --cache-location .eslintcache --cache-strategy content ./src",
    "test": "vitest run",
    "bench": "vitest bench",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --incremental --tsBuildInfoFile .tsbuildinfo/app.tsbuildinfo",
    "build:dev": "vite build --mode development --minify false",
    "build:dev-watch": "vite build --mode development --watch --minify false",
    "build:prod": "vite build"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@apollo/client": "^4.3.1",
    "@plitzi/nexus": "^1.4.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@apollo/client": "^4.3.7",
    "@eslint/js": "^10.0.1",
    "@plitzi/nexus": "^1.4.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.6",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "lodash": "^4.18.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "vitest-fetch-mock": "^0.4.5"
  },
  "peerDependenciesMeta": {
    "@apollo/client": {
      "optional": true
    },
    "@plitzi/nexus": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
