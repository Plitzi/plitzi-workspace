{
  "compilerOptions": {
    /* to allow jsdoc be converted to ts */
    "allowJs": true,
    "maxNodeModuleJsDepth": 5,

    /* For project references and the editor's resolution of them. The `typecheck` scripts turn it off
       (`--composite false --emitDeclarationOnly false`): a check emits nothing, and with it on TypeScript leaves a
       `.tsbuildinfo` beside every config it visits — build state from a command that builds nothing. */
    "composite": true,
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    /* A workspace package's `exports` lead with `@plitzi/source`, its sources: the editor, the typecheck and the typed
       lint read the packages a package depends on as they are now, not as their last build left `dist`. The
       declaration build turns it off (`vite.config.ts`), so what is emitted and published is unchanged. */
    "customConditions": ["@plitzi/source"],
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "emitDeclarationOnly": true,
    "jsx": "react-jsx", // @todo: react/jsx-runtime

    /* Linting */
    "strict": true,
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      // "@icons/*": ["./src/icons/*"],
      // "@components/*": ["./src/components/*"],
      // "@hooks/*": ["./src/hooks/*"],
      // "@/*": ["./src/*"]
    },
    "rootDir": "./",
    "outDir": "./dist"
  },
  "include": ["src", "package.json", "vite.config.ts"],
  "exclude": ["dist", "node_modules", "**/dist", "setupTests.ts"]
}
