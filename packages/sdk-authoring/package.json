{
  "name": "@plitzi/sdk-authoring",
  "version": "0.38.10",
  "license": "AGPL-3.0",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/index-*.js",
    "dist/node.js",
    "dist/node.d.ts",
    "skills"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./skills/*": "./skills/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "https",
    "url": "https://github.com/plitzi/plitzi-workspace.git"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "lint": "eslint ./src ./skills ./templates",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:dev": "vite build --mode development",
    "generate:attribute-names": "node scripts/generate-attribute-names.ts",
    "generate:authoring-errors": "vitest run src/schema/codesPage.test.ts --update=all",
    "build:prod": "vite build"
  },
  "peerDependencies": {
    "@types/react": "^19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.3",
    "@plitzi/plitzi-ui": "^1.6.32",
    "@plitzi/sdk-elements": "workspace:*",
    "@plitzi/sdk-interactions": "workspace:*",
    "@plitzi/sdk-schema": "workspace:*",
    "@plitzi/sdk-shared": "workspace:*",
    "@plitzi/sdk-style": "workspace:*",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  }
}
