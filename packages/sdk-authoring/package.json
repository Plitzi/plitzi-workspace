{
  "name": "@plitzi/sdk-authoring",
  "version": "0.37.1",
  "license": "AGPL-3.0",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "skills"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./skills/*": "./skills/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "https",
    "url": "https://github.com/plitzi/plitzi-workspace.git"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "lint": "eslint ./src",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:dev": "vite build --mode development",
    "generate:attribute-names": "node scripts/generate-attribute-names.ts",
    "build:prod": "vite build"
  },
  "peerDependencies": {
    "@types/react": "^19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.2",
    "@plitzi/plitzi-ui": "^1.6.22",
    "@plitzi/sdk-elements": "workspace:*",
    "@plitzi/sdk-interactions": "workspace:*",
    "@plitzi/sdk-schema": "workspace:*",
    "@plitzi/sdk-shared": "workspace:*",
    "@plitzi/sdk-style": "workspace:*",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.1"
  }
}
