{
  "extends": "../sdk-shared/tsconfig.app.json",
  "references": [{ "path": "../sdk-shared" }],
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    // The skill's recipes and the templates import the package by name, as a project does; typechecked here against its
