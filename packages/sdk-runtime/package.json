{
  "name": "@plitzi/sdk-runtime",
  "version": "0.39.1",
  "license": "AGPL-3.0",
  "description": "The contract a space's own code is written against, and what runs it with no access: the functions runner, its isolates, and the host of a space's runtime.",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@plitzi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./functions-api.d.ts": "./dist/functions-api.d.ts",
    "./*": {
      "@plitzi/source": "./src/*/index.ts",
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.mjs"
    }
  },
  "repository": {
    "type": "https",
    "url": "https://github.com/plitzi/plitzi-workspace.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "lint": "eslint ./src",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "build:dev": "vite build --mode development && node scripts/prelude.mjs && node scripts/functions-api.mjs",
    "build:prod": "vite build && node scripts/prelude.mjs && node scripts/functions-api.mjs"
  },
  "dependencies": {
    "@plitzi/sdk-kernel": "workspace:*",
    "@plitzi/sdk-shared": "workspace:*",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "isolated-vm": "^7.0.1"
  },
  "peerDependenciesMeta": {
    "isolated-vm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "core-js": "^3.50.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "isolated-vm": "^7.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  }
}
