{
  "name": "@plitzi/sdk-schema",
  "version": "0.33.2",
  "license": "AGPL-3.0",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./SchemaReducer": {
      "types": "./dist/SchemaReducer.d.ts",
      "import": "./dist/SchemaReducer.mjs"
    },
    "./authoring": {
      "types": "./dist/authoring/index.d.ts",
      "import": "./dist/authoring/index.mjs"
    },
    "./authoring/actions": {
      "import": "./dist/authoring/actions.mjs"
    },
    "./authoring/bindings": {
      "types": "./dist/authoring/bindings.d.ts",
      "import": "./dist/authoring/bindings.mjs"
    },
    "./authoring/flows": {
      "types": "./dist/authoring/flows.d.ts",
      "import": "./dist/authoring/flows.mjs"
    },
    "./authoring/ids": {
      "types": "./dist/authoring/ids.d.ts",
      "import": "./dist/authoring/ids.mjs"
    },
    "./authoring/index": {
      "types": "./dist/authoring/index.d.ts",
      "import": "./dist/authoring/index.mjs"
    },
    "./authoring/space": {
      "types": "./dist/authoring/space.d.ts",
      "import": "./dist/authoring/space.mjs"
    },
    "./authoring/styles": {
      "types": "./dist/authoring/styles.d.ts",
      "import": "./dist/authoring/styles.mjs"
    },
    "./authoring/suggest": {
      "types": "./dist/authoring/suggest.d.ts",
      "import": "./dist/authoring/suggest.mjs"
    },
    "./authoring/validate": {
      "types": "./dist/authoring/validate.d.ts",
      "import": "./dist/authoring/validate.mjs"
    },
    "./helpers/FlatMap": {
      "types": "./dist/helpers/FlatMap.d.ts",
      "import": "./dist/helpers/FlatMap.mjs"
    },
    "./helpers/authoring": {
      "types": "./dist/helpers/authoring.d.ts",
      "import": "./dist/helpers/authoring.mjs"
    },
    "./helpers/idRef": {
      "types": "./dist/helpers/idRef.d.ts",
      "import": "./dist/helpers/idRef.mjs"
    },
    "./helpers/schemaValidator": {
      "types": "./dist/helpers/schemaValidator.d.ts",
      "import": "./dist/helpers/schemaValidator.mjs"
    },
    "./index": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "lint": "eslint ./src",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "build:dev": "vite build --mode development --minify false && node ../sdk-shared/scripts/generate-exports.mjs",
    "build:dev-watch": "vite build --mode development --watch --minify false",
    "build:prod": "vite build && node ../sdk-shared/scripts/generate-exports.mjs"
  },
  "dependencies": {
    "@plitzi/plitzi-ui": "^1.6.20",
    "@plitzi/sdk-shared": "workspace:*",
    "@plitzi/sdk-style": "workspace:*",
    "prop-types": "^15.8.1"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
