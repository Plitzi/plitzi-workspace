{
  "name": "@plitzi/sdk-actions",
  "version": "0.39.3",
  "license": "AGPL-3.0",
  "description": "The actions engine: server actions, a space's functions and runtimes as the platform holds them, the connectors, realtime, jobs, and the stock queues and stores. What a worker runs; what a page server is handed.",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@plitzi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./*": {
      "@plitzi/source": "./src/*/index.ts",
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.mjs",
      "default": "./dist/*/index.mjs"
    }
  },
  "repository": {
    "type": "https",
    "url": "https://github.com/plitzi/plitzi-workspace.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "lint": "eslint --cache --cache-location .eslintcache --cache-strategy content ./src",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --incremental --tsBuildInfoFile .tsbuildinfo/app.tsbuildinfo",
    "test": "vitest run",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build"
  },
  "dependencies": {
    "@plitzi/sdk-kernel": "workspace:*",
    "@plitzi/sdk-shared": "workspace:*",
    "nodemailer": "^10.4.0",
    "ws": "^8.22.2"
  },
  "peerDependencies": {
    "esbuild": "^0.28.2",
    "mongodb": "^6 || ^7",
    "mysql2": "^3"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@plitzi/sdk-runtime": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "core-js": "^3.51.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "ioredis": "^6.0.0",
    "isolated-vm": "^7.0.2",
    "mongodb": "^7.8.0",
    "mysql2": "^3.24.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  }
}
