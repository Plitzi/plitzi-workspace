{
  "name": "@plitzi/sdk-navigation",
  "version": "0.38.16",
  "license": "AGPL-3.0",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@plitzi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./*": {
      "@plitzi/source": "./src/*/index.ts",
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.mjs"
    }
  },
  "scripts": {
    "lint": "eslint ./src",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "build:dev": "vite build --mode development --minify false",
    "build:dev-watch": "vite build --mode development --watch --minify false",
    "build:prod": "vite build"
  },
  "type": "module",
  "sideEffects": false,
  "devDependencies": {
    "eslint": "^9.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@plitzi/plitzi-ui": "^1.6.33",
    "@plitzi/sdk-shared": "workspace:*"
  }
}
