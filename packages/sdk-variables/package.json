{
  "name": "@plitzi/sdk-variables",
  "version": "0.38.20",
  "license": "AGPL-3.0",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@plitzi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./*": {
      "@plitzi/source": "./src/*/index.ts",
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.mjs"
    }
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "lint": "eslint ./src",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "build:dev": "vite build --mode development --minify false",
    "build:dev-watch": "vite build --mode development --watch --minify false",
    "build:prod": "vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@plitzi/plitzi-ui": "^1.6.34",
    "@plitzi/sdk-shared": "workspace:*",
    "clsx": "^2.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "react": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^19"
  }
}
