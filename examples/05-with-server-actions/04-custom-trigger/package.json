{
  "name": "@plitzi/example-server-actions-custom-trigger",
  "version": "0.0.0",
  "private": true,
  "description": "The other extension point: a trigger this deployment mounts itself, over a store it already runs.",
  "type": "module",
  "scripts": {
    "start": "node --import tsx src/main.ts",
