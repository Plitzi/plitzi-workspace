{
  "name": "@plitzi/example-server-actions-render",
  "version": "0.0.0",
  "private": true,
  "description": "A page rendered with data the server fetched: an action runs while the page renders, and the HTML arrives with the cats already in it.",
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "start:dev": "node --watch-path=./src src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "yarn run -T eslint ."
  },
  "dependencies": {
    "@plitzi/example-space": "workspace:*",
    "@plitzi/sdk-authoring": "workspace:*",
    "@plitzi/sdk-server": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
