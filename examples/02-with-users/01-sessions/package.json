{
  "name": "@plitzi/example-with-users",
  "version": "0.0.0",
  "private": true,
  "description": "A server-rendered Plitzi space that knows who is looking at it: sign in, stay signed in, sign out.",
  "type": "module",
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "start:dev": "tsx watch --exclude \".sdk-plugins/**\" src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@plitzi/example-space": "workspace:*",
    "@plitzi/sdk-authoring": "workspace:*",
    "@plitzi/sdk-server": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
