{
  "name": "@plitzi/example-space",
  "version": "0.0.0",
  "private": true,
  "description": "The sample Plitzi space every example renders, so each one shows its own wiring and not a copy of the data.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.js",
    "./offline-data.json": "./offline-data.json",
    "./browser": {
      "types": "./browser.d.ts",
      "default": "./browser.js"
    },
    "./space": "./space.ts"
  },
  "devDependencies": {
    "@plitzi/sdk-shared": "workspace:*",
    "@types/node": "^24.10.2",
    "tsx": "^4.20.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "author": "node --import tsx ./author.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@plitzi/sdk-server": "workspace:*"
  }
}
