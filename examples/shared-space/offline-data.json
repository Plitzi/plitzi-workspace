  "style": {
    "platform": {
      "desktop": {
        "heading": {
          "name": "heading",
          "type": "element",
          "componentType": "heading",
          "attributes": {
            "base": {
              "default": {
                "color": "var(--foreground)"
              },
              "variants": {
                "lg": {
                  "default": {
                    "font-size": "50px"
                  }
                },
                "title": {
                  "default": {
                    "margin-top": "0px",
                    "margin-bottom": "0px"
                  }
                }
              }
            }
          },
          "cache": ".plitzi__heading{color:var(--foreground);&[data-variant=\"lg\"],&.heading--lg{font-size:50px;}&[data-variant=\"title\"],&.heading--title{margin-top:0px;margin-bottom:0px;}}"
        },
        "text": {
          "name": "text",
          "type": "element",
          "componentType": "text",
          "attributes": {
            "base": {
              "default": {
                "color": "var(--foreground)"
              }
            }
          },
          "cache": ".plitzi__text{color:var(--foreground);}"
        },
        "paragraph": {
          "name": "paragraph",
          "type": "element",
