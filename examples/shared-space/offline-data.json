on:column;min-height:auto;min-width:auto;flex-grow:1;flex-shrink:1;flex-basis:0%;align-items:flex-start;}}\n@media (max-width: 48rem) and (min-width: 0) {.page{padding-top:32px;padding-right:24px;padding-bottom:32px;padding-left:24px;justify-content:flex-start;}\n.logoFrame{width:90vw;height:40vh;}\n.cards{row-gap:24px;column-gap:24px;flex-direction:column;min-height:auto;min-width:auto;align-items:stretch;}}\n:root {\n    --foreground: #17171c;\n    --grid-big: #00000010;\n    --grid-small: #0000000A;\n    --background-outer: #dce6ff;\n    --background-inner: #ffffff;\n}\n\n@media (prefers-color-scheme: light) {\n  :root:not(.dark) {\n    --foreground: #17171c;\n    --grid-big: #00000010;\n    --grid-small: #0000000A;\n    --background-outer: #dce6ff;\n    --background-inner: #ffffff;\n  }\n}\n\n@media (prefers-color-scheme: dark) {\n  :root:not(.light) {\n    --foreground: #fafafa;\n    --grid-big: #ffffff10;\n    --grid-small: #ffffff0A;\n    --background-outer: #000000;\n    --background-inner: #080866;\n  }\n}\n\n:root.light {\n    --foreground: #17171c;\n    --grid-big: #00000010;\n    --grid-small: #0000000A;\n    --background-outer: #dce6ff;\n    --background-inner: #ffffff;\n}\n\n:root.dark {\n    --foreground: #fafafa;\n    --grid-big: #ffffff10;\n    --grid-small: #ffffff0A;\n    --background-outer: #000000;\n    --background-inner: #080866;\n}"
