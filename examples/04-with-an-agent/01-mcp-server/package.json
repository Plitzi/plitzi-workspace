{
  "name": "@plitzi/example-mcp-server",
  "version": "0.0.0",
  "private": true,
  "description": "A Plitzi MCP server an agent can read and edit a space through.",
  "type": "module",
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "start:dev": "tsx watch --exclude \".sdk-plugins/**\" src/main.ts",
    "inspector": "yarn dlx @modelcontextprotocol/inspector@latest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@plitzi/example-space": "workspace:*",
    "@plitzi/sdk-mcp": "workspace:*",
    "@plitzi/sdk-server": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
