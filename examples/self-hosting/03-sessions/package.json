{
  "name": "@plitzi/example-with-users",
  "version": "0.0.0",
  "private": true,
  "description": "A server-rendered Plitzi space that knows who is looking at it: sign in, stay signed in, sign out.",
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "start:dev": "node --watch-path=./src src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "yarn run -T eslint ."
  },
  "dependencies": {
    "@plitzi/example-space": "workspace:*",
    "@plitzi/sdk-authoring": "workspace:*",
    "@plitzi/sdk-server": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
