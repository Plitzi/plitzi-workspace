{
  "name": "@plitzi/example-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "A space's runtime, self-hosted: its own server code — a task, a route, a stream held open — loaded into a server of your own.",
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "start:dev": "node --watch-path=./src src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "yarn run -T eslint ."
  },
  "dependencies": {
    "@plitzi/sdk-authoring": "workspace:*",
    "@plitzi/sdk-server": "workspace:*",
    "@plitzi/sdk-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
