{
  "name": "@plitzi/example-template-authoring",
  "version": "0.0.0",
  "private": true,
  "description": "A publishable template, authored in TypeScript and written out as JSON — one dependency, no server, no account.",
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "start:dev": "node --watch-path=./src src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@plitzi/sdk-authoring": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
