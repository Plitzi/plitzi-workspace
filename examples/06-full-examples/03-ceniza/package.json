{
  "name": "@plitzi/example-ceniza",
  "version": "0.0.0",
  "private": true,
  "description": "A restaurant's whole website: ten pages, live table availability, bookings with a confirmation email, a newsletter and a journal — every server action built from the tasks the server ships.",
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "start:dev": "node --watch-path=./src src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "yarn run -T eslint ."
  },
  "dependencies": {
    "@plitzi/sdk-authoring": "workspace:*",
    "@plitzi/sdk-server": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
