{
  "name": "@plitzi/example-whiteboard",
  "version": "0.0.0",
  "private": true,
  "description": "A collaborative whiteboard: an infinite canvas in a hand-drawn stroke, where every change goes through a server action and reaches everyone on the board through a realtime channel.",
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "start:dev": "node --watch-path=./src src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@plitzi/sdk-authoring": "workspace:*",
    "@plitzi/sdk-elements": "workspace:*",
    "@plitzi/sdk-server": "workspace:*",
    "ioredis": "^6.0.0",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "roughjs": "^4.6.6",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
