{
  "name": "@plitzi/example-cloud-space",
  "version": "0.0.0",
  "private": true,
  "description": "Server-render a space that lives in Plitzi, from a server that is not Plitzi's.",
  "type": "module",
  "scripts": {
    "start": "node --use-system-ca src/main.ts",
    "start:dev": "node --use-system-ca --watch-path=./src src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@plitzi/sdk-server": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
