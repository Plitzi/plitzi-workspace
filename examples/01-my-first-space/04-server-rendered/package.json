{
  "name": "@plitzi/example-ssr-pages",
  "version": "0.0.0",
  "private": true,
  "description": "Server-render a Plitzi space over HTTP with @plitzi/sdk-server.",
  "type": "module",
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "start:dev": "tsx watch --exclude \".sdk-plugins/**\" src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "playwright test"
  },
  "dependencies": {
    "@plitzi/example-space": "workspace:*",
    "@plitzi/sdk-server": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@plitzi/sdk-authoring": "workspace:*",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
