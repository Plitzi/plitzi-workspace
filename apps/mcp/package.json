{
  "name": "@plitzi/sdk-mcp",
  "version": "0.39.3",
  "license": "AGPL-3.0",
  "files": [
    "dist",
    "skills"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "@plitzi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "@plitzi/source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./render": {
      "@plitzi/source": "./src/render.ts",
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js",
      "default": "./dist/render.js"
    },
    "./preview": {
      "@plitzi/source": "./src/preview.ts",
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js",
      "default": "./dist/preview.js"
    }
  },
  "repository": {
    "type": "https",
    "url": "https://github.com/plitzi/plitzi-workspace.git"
  },
  "type": "module",
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "sideEffects": false,
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@plitzi/plitzi-sdk": "workspace:*",
    "@plitzi/sdk-authoring": "workspace:*",
    "@plitzi/sdk-kernel": "workspace:*",
    "@plitzi/sdk-schema": "workspace:*",
    "@plitzi/sdk-server": "workspace:*",
    "@plitzi/sdk-shared": "workspace:*",
    "@plitzi/sdk-style": "workspace:*",
    "ejs": "^7.0.2",
    "esbuild": "^0.28.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "start": "TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx dev/main.ts",
    "start:dev": "TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx --watch dev/main.ts",
    "start:inspect": "TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx --inspect dev/main.ts",
    "inspector": "yarn dlx @modelcontextprotocol/inspector@latest",
    "inspector:legacy": "yarn dlx @modelcontextprotocol/inspector@1.0.1",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build",
    "lint": "TIMING=1 eslint --cache --cache-location .eslintcache --cache-strategy content ./src ./dev",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --incremental --tsBuildInfoFile .tsbuildinfo/app.tsbuildinfo",
    "test": "vitest run",
    "test:e2e": "vitest run src/modules/mcp/e2e",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run"
  }
}
