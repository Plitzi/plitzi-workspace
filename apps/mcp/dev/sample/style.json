        "cache": ".headline{z-index:1;color:white;margin-bottom:40px;}"
      },
      "rscSection": {
        "name": "rscSection",
        "type": "class",
        "attributes": {
          "base": {
            "default": {
              "z-index": "1"
            }
          }
        },
        "cache": ".rscSection{z-index:1;}"
      },
      "cards": {
        "name": "cards",
        "type": "class",
        "attributes": {
          "base": {
            "default": {
              "display": "flex",
              "align-items": "center",
              "row-gap": "40px",
              "column-gap": "40px",
              "z-index": "1"
            }
          }
        },
        "cache": ".cards{display:flex;align-items:center;row-gap:40px;column-gap:40px;z-index:1;}"
      },
