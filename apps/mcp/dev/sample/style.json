              "transition-duration": "150ms"
            },
            "ancestors": {
              "buttonLink": {
                "states": {
                  "hover": {
                    "transform": "translateX(10px)"
                  }
                }
              }
            }
          }
        },
        "cache": ".titleIcon{margin-left:10px;transition-property:transform;transition-timing-function:cubic-bezier(0.4, 0, 0.2, 1);transition-duration:150ms;:where(.buttonLink:hover) &{transform:translateX(10px);}}"
      }
    },
    "tablet": {
      "page": {
        "name": "page",
        "type": "class",
        "attributes": {
          "base": {
            "default": {
              "justify-content": "flex-start",
              "padding-top": "60px",
              "padding-right": "60px",
              "padding-bottom": "60px",
