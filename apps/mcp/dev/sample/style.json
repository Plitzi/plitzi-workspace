    "color": {
      "foreground": {
        "light": "#17171c",
        "dark": "#fafafa",
        "default": "#17171c"
      },
      "grid-big": {
        "light": "#00000010",
        "dark": "#ffffff10",
        "default": "#00000010"
      },
      "grid-small": {
        "light": "#0000000A",
        "dark": "#ffffff0A",
        "default": "#0000000A"
      },
      "background-outer": {
        "light": "#dce6ff",
        "dark": "#000000",
        "default": "#dce6ff"
      },
      "background-inner": {
        "light": "#ffffff",
        "dark": "#080866",
        "default": "#ffffff"
      }
    }
  },
  "fonts": [],
  "cache": ".plitzi__heading{color:var(--foreground);&[data-variant=\"lg\"],&.heading--lg{font-size:50px;}&[data-variant=\"title\"],&.heading--title{margin-top:0px;margin-bottom:0px;}}\n.plitzi__text{color:var(--foreground);}\n.plitzi__paragraph{color:var(--foreground);}\n.plitzi__fontAwesome{color:var(--foreground);}\n.page{display:flex;flex-direction:column;align-items:center;justify-content:space-between;padding-top:100px;padding-right:100px;padding-bottom:100px;padding-left:100px;position:relative;min-width:100%;min-height:100vh;background-image:radial-gradient(circle at 50% 50%, var(--background-inner) -30%, var(--background-outer) 100%);background-size:auto;background-position:0% 0%;background-repeat:no-repeat;background-attachment:scroll;background-clip:border-box;}\n.backdrop{top:0%;right:0%;bottom:0%;left:0%;position:fixed;background-image:linear-gradient(0deg, var(--grid-big) 1px, transparent 1px),linear-gradient(90deg, var(--grid-big) 1px, transparent 1px),linear-gradient(0deg, var(--grid-small) 1px, transparent 1px),linear-gradient(90deg, var(--grid-small) 1px, transparent 1px);background-size:100px 100px,100px 100px,10px 10px,10px 10px;background-position:0% 0%,0% 0%,0% 0%,0% 0%;background-repeat:repeat,repeat,repeat,repeat;background-attachment:scroll,scroll,scroll,scroll;background-clip:border-box,border-box,border-box,border-box;pointer-events:none;}\n.logoFrame{width:75%;height:75vh;position:absolute;}\n.logo{width:100%;height:100%;opacity:0.45;}\n.headline{z-index:1;color:white;margin-bottom:40px;}\n.rscSection{z-index:1;}\n.cards{display:flex;align-items:center;row-gap:40px;column-gap:40px;z-index:1;}\n.buttonLink{color:white;flex-grow:1;flex-shrink:1;flex-basis:0px;}\n.titleContainer{display:flex;align-items:center;}\n.titleIcon{margin-left:10px;transition-property:transform;transition-timing-function:cubic-bezier(0.4, 0, 0.2, 1);transition-duration:150ms;:where(.buttonLink:hover) &{transform:translateX(10px);}}\n@media (max-width: 64rem) and (min-width: 48rem) {.page{justify-content:flex-start;padding-top:60px;padding-right:60px;padding-bottom:60px;padding-left:60px;}\n.cards{flex-direction:column;min-height:auto;min-width:auto;flex-grow:1;flex-shrink:1;flex-basis:0%;align-items:flex-start;}}\n@media (max-width: 48rem) and (min-width: 0) {.page{justify-content:flex-start;padding-top:32px;padding-right:24px;padding-bottom:32px;padding-left:24px;}\n.logoFrame{width:90%;height:40vh;}\n.cards{flex-direction:column;min-height:auto;min-width:auto;flex-grow:1;flex-shrink:1;flex-basis:0%;align-items:stretch;row-gap:24px;column-gap:24px;}}\n:root {\n    --foreground: #17171c;\n    --grid-big: #00000010;\n    --grid-small: #0000000A;\n    --background-outer: #dce6ff;\n    --background-inner: #ffffff;\n}\n\n@media (prefers-color-scheme: light) {\n  :root:not(.dark) {\n    --foreground: #17171c;\n    --grid-big: #00000010;\n    --grid-small: #0000000A;\n    --background-outer: #dce6ff;\n    --background-inner: #ffffff;\n  }\n}\n\n@media (prefers-color-scheme: dark) {\n  :root:not(.light) {\n    --foreground: #fafafa;\n    --grid-big: #ffffff10;\n    --grid-small: #ffffff0A;\n    --background-outer: #000000;\n    --background-inner: #080866;\n  }\n}\n\n:root.light, .light {\n    --foreground: #17171c;\n    --grid-big: #00000010;\n    --grid-small: #0000000A;\n    --background-outer: #dce6ff;\n    --background-inner: #ffffff;\n}\n\n:root.dark, .dark {\n    --foreground: #fafafa;\n    --grid-big: #ffffff10;\n    --grid-small: #ffffff0A;\n    --background-outer: #000000;\n    --background-inner: #080866;\n}"
}
