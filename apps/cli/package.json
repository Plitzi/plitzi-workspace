{
  "name": "@plitzi/cli",
  "version": "0.38.0",
  "license": "AGPL-3.0",
  "description": "Command line for Plitzi: scaffold a project that renders a space, a plugin package, or an element of your own.",
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "bin": {
    "plitzi": "./dist/index.js"
  },
  "exports": {
    "./skills/*": "./skills/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "https",
    "url": "https://github.com/plitzi/plitzi-workspace.git"
  },
  "sideEffects": false,
  "dependencies": {
    "@plitzi/sdk-authoring": "workspace:*",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@plitzi/sdk-shared": "workspace:*",
    "@types/node": "^26.6.4",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "build:dev": "vite build --mode development",
    "build:prod": "vite build",
    "lint": "TIMING=1 eslint ./src",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "cli": "node --import tsx src/index.ts"
  }
}
