{
  "name": "@plitzi/cli",
  "version": "0.39.4",
  "license": "AGPL-3.0",
  "description": "Command line for Plitzi: scaffold a project that renders a space, a plugin package, or an element of your own.",
  "files": [
    "dist",
    "schemas",
    "skills"
  ],
  "type": "module",
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "bin": {
    "plitzi": "./dist/bin.js"
  },
  "exports": {
    "./skills/*": "./skills/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "https",
    "url": "https://github.com/plitzi/plitzi-workspace.git"
  },
  "sideEffects": false,
  "dependencies": {
    "@plitzi/sdk-authoring": "workspace:*",
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "playwright-core": "^1.65.0"
  },
  "devDependencies": {
    "@plitzi/sdk-shared": "workspace:*",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "build:dev": "vite build --mode development",
    "build:prod": "vite build",
    "lint": "TIMING=1 eslint --cache --cache-location .eslintcache --cache-strategy content ./src",
    "generate:refusals": "vitest run src/core/refusals.test.ts --update=all",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --incremental --tsBuildInfoFile .tsbuildinfo/app.tsbuildinfo",
    "test": "vitest run",
    "cli": "node --import tsx src/index.ts"
  }
}
