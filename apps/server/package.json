{
  "name": "@plitzi/sdk-server",
  "version": "0.39.4",
  "license": "AGPL-3.0",
  "files": [
    "dist",
    "skills"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "@plitzi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auth": {
      "@plitzi/source": "./src/auth.ts",
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js",
      "default": "./dist/auth.js"
    },
    "./oauth": {
      "@plitzi/source": "./src/oauth.ts",
      "types": "./dist/oauth.d.ts",
      "import": "./dist/oauth.js",
      "default": "./dist/oauth.js"
    },
    "./handlers": {
      "@plitzi/source": "./src/handlers.ts",
      "types": "./dist/handlers.d.ts",
      "import": "./dist/handlers.js",
      "default": "./dist/handlers.js"
    },
    "./ssr": {
      "@plitzi/source": "./src/ssr.ts",
      "types": "./dist/ssr.d.ts",
      "import": "./dist/ssr.js",
      "default": "./dist/ssr.js"
    },
    "./platform": {
      "@plitzi/source": "./src/platform.ts",
      "types": "./dist/platform.d.ts",
      "import": "./dist/platform.js",
      "default": "./dist/platform.js"
    },
    "./spaces": {
      "@plitzi/source": "./src/spaces.ts",
      "types": "./dist/spaces.d.ts",
      "import": "./dist/spaces.js",
      "default": "./dist/spaces.js"
    },
    "./cache": {
      "@plitzi/source": "./src/cache.ts",
      "types": "./dist/cache.d.ts",
      "import": "./dist/cache.js",
      "default": "./dist/cache.js"
    },
    "./project": {
      "@plitzi/source": "./src/project.ts",
      "types": "./dist/project.d.ts",
      "import": "./dist/project.js",
      "default": "./dist/project.js"
    },
    "./bundle": {
      "@plitzi/source": "./src/bundle.ts",
      "types": "./dist/bundle.d.ts",
      "import": "./dist/bundle.js",
      "default": "./dist/bundle.js"
    },
    "./env": {
      "@plitzi/source": "./src/env.ts",
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js",
      "default": "./dist/env.js"
    }
  },
  "repository": {
    "type": "https",
    "url": "https://github.com/plitzi/plitzi-workspace.git"
  },
  "type": "module",
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "sideEffects": [
    "./dist/env.js"
  ],
  "dependencies": {
    "@plitzi/plitzi-sdk": "workspace:*",
    "@plitzi/sdk-kernel": "workspace:*",
    "@plitzi/sdk-shared": "workspace:*",
    "ejs": "^7.0.2",
    "esbuild": "^0.28.2",
    "jsonwebtoken": "^9.0.3",
    "subset-font": "^2.9.0"
  },
  "peerDependencies": {
    "@plitzi/sdk-actions": "^0.39.4",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.34.0"
  },
  "peerDependenciesMeta": {
    "@plitzi/sdk-actions": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@plitzi/sdk-actions": "workspace:*",
    "@plitzi/sdk-runtime": "workspace:*",
    "@types/ejs": "^3.1.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/subset-font": "^2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "ioredis": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "ws": "^8.22.2"
  },
  "scripts": {
    "prepack": "node scripts/copy-authoring-skill.mjs",
    "start:dev": "node --import ./dev/register-alias.mjs --watch dev/main.ts",
    "start": "TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx dev/main.ts",
    "start:watch": "TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx --watch dev/main.ts",
    "start:inspect": "TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx --inspect dev/main.ts",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build",
    "lint": "TIMING=1 eslint --cache --cache-location .eslintcache --cache-strategy content ./src ./dev",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --incremental --tsBuildInfoFile .tsbuildinfo/app.tsbuildinfo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run"
  }
}
