{
  "name": "@plitzi/sdk-server",
  "version": "0.37.9",
  "license": "AGPL-3.0",
  "files": [
    "dist",
    "skills"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js",
      "default": "./dist/auth.js"
    },
    "./oauth": {
      "types": "./dist/oauth.d.ts",
      "import": "./dist/oauth.js",
      "default": "./dist/oauth.js"
    },
    "./kernel": {
      "types": "./dist/kernel.d.ts",
      "import": "./dist/kernel.js",
      "default": "./dist/kernel.js"
    },
    "./mysql": {
      "types": "./dist/mysql.d.ts",
      "import": "./dist/mysql.js",
      "default": "./dist/mysql.js"
    },
    "./mongo": {
      "types": "./dist/mongo.d.ts",
      "import": "./dist/mongo.js",
      "default": "./dist/mongo.js"
    },
    "./handlers": {
      "types": "./dist/handlers.d.ts",
      "import": "./dist/handlers.js",
      "default": "./dist/handlers.js"
    },
    "./ssr": {
      "types": "./dist/ssr.d.ts",
      "import": "./dist/ssr.js",
      "default": "./dist/ssr.js"
    },
    "./actions": {
      "types": "./dist/actions.d.ts",
      "import": "./dist/actions.js",
      "default": "./dist/actions.js"
    },
    "./functions": {
      "types": "./dist/functions.d.ts",
      "import": "./dist/functions.js",
      "default": "./dist/functions.js"
    },
    "./functions-runner": {
      "types": "./dist/functionsRunner.d.ts",
      "import": "./dist/functionsRunner.js",
      "default": "./dist/functionsRunner.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./functions-api.d.ts": "./dist/functions-api.d.ts"
  },
  "repository": {
    "type": "https",
    "url": "https://github.com/plitzi/plitzi-workspace.git"
  },
  "type": "module",
  "sideEffects": false,
  "dependencies": {
    "@plitzi/plitzi-sdk": "workspace:*",
    "@plitzi/sdk-shared": "workspace:*",
    "ejs": "^6.0.1",
    "esbuild": "^0.28.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.10",
    "undici": "^8.11.2",
    "ws": "^8.21.1"
  },
  "peerDependencies": {
    "core-js": "^3.50.0",
    "isolated-vm": "^7.0.1",
    "mongodb": "^6 || ^7",
    "mysql2": "^3",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "core-js": {
      "optional": true
    },
    "isolated-vm": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.2",
    "@types/ejs": "^3.1.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "core-js": "^3.50.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "ioredis": "^6.0.0",
    "isolated-vm": "^7.0.1",
    "mongodb": "^7.7.0",
    "mysql2": "^3.24.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "prepack": "node scripts/copy-authoring-skill.mjs",
    "start:dev": "node --import ./dev/register-alias.mjs --watch dev/main.ts",
    "start": "TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx dev/main.ts",
    "start:watch": "TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx --watch dev/main.ts",
    "start:inspect": "TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx --inspect dev/main.ts",
    "build:dev": "vite build --mode development && node scripts/functions-api.mjs",
    "build:prod": "vite build && node scripts/functions-api.mjs",
    "lint": "TIMING=1 eslint ./src ./dev",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run"
  }
}
