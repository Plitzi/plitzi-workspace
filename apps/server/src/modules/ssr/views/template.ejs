<!doctype html>
<html lang="<%= (locals.head && locals.head.lang) || 'en' %>"<% if (locals.themeClass) { %> class="<%= locals.themeClass %>"<% } %><% if (locals.scriptPolicy) { %> data-plitzi-script-policy="<%= locals.scriptPolicy %>"<% } %>>
  <head>
    <meta charset="utf-8" />
    <title><%= locals.title || '' %></title>
    <%
      /*
        What a link preview, a search engine and the browser read of the page, as `pageHeadTags` (@plitzi/sdk-shared)
        decides it — the page's description, robots, Open Graph and card with its picture, its canonical address, the
        space's icon and colour. The page keeps them as it moves (`PageHead`) from the same definition.
      */
    %>
    <% ((locals.head && locals.head.meta) || []).forEach(function (tag) { %>
    <meta <%= tag.attribute %>="<%= tag.key %>" content="<%= tag.content %>"<% if (tag.media) { %> media="<%= tag.media %>"<% } %> />
    <% }) %>
    <% (locals.structuredData || []).forEach(function (json) { %>
    <script type="application/ld+json"><%- json %></script>
    <% }) %>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <% ((locals.head && locals.head.links) || []).forEach(function (link) { %>
    <link rel="<%= link.rel %>" href="<%= link.href %>"<% if (link.type) { %> type="<%= link.type %>"<% } %> />
    <% }) %>

    <%
      /*
        The visitor's theme is on <html> above, and there is nothing to run here for it.

        A page paints long before its JavaScript has mounted anything, so the theme cannot be settled by anything the
        SDK does at mount — a visitor who chose light on a machine set to dark would watch the dark page for about
        four hundred milliseconds. This document used to ship a blocking script in the head to beat that paint.

        It no longer has to. The choice is in a COOKIE, which is the one place a browser keeps a preference that the
        SERVER can read too: `prepareRender` takes it off the request and hands the class down as `themeClass`.
        Nothing blocks, nothing is measured, and the markup is right the first time.
      */
    %>

    <%
      /*
        The space's web fonts, in the document rather than fetched by the SDK once it mounts.

        A page paints long before its JavaScript exists. A face asked for at hydration arrives after the text it
        was meant for has already been drawn in a fallback, and the visitor watches it reflow — which is exactly
        what happened while the only thing that requested a family was the SDK's client-side asset rail.

        The value is `fontsToHead(style.fonts, ...)` from @plitzi/sdk-shared: one place decides what a manifest
        means, because SSR, the client, the builder canvas and the static export must all decide it the same way.
      */
    %>
    <% if (locals.fonts) { %>
    <% for (const origin of locals.fonts.preconnect) { %>
    <link rel="preconnect" href="<%= origin.href %>" <%- origin.crossorigin ? 'crossorigin' : '' %> />
    <% } %>
    <% for (const link of locals.fonts.links) { %>
    <link
      rel="<%= link.rel %>"
      href="<%= link.href %>"
      <%- link.as ? `as="${link.as}"` : '' %>
      <%- link.type ? `type="${link.type}"` : '' %>
      <%- link.crossorigin ? 'crossorigin' : '' %>
    />
    <% } %>
    <% if (locals.fonts.faces) { %>
    <%
      /* Marked so the SDK can tell the document already carries them and does not declare a second copy. */
    %>
    <style data-plitzi-fonts><%- locals.fonts.faces %></style>
    <% } %>
    <% } %>

    <%#
      What the first paint waits for, and nothing else: the head asks for the stylesheets alone. The scripts and the
      space's document — which hydrating needs, and painting does not — are asked by the bootstrap once the page has
      painted (see it at the end of the body).
    %>
    <link href="<%= locals.cssPath || '' %>" rel="stylesheet" />
    <%# The space's compiled stylesheet, when the page links it rather than carrying it (STYLE_SHEET_ID): in the head,
        so the page is painted with it from its first frame. %>
    <% if (locals.styleSheetPath) { %>
    <link id="plitzi-style" href="<%= locals.styleSheetPath %>" rel="stylesheet" />
    <% } %>
    <% if (locals.builderCssPath) { %>
    <link href="<%= locals.builderCssPath %>" rel="stylesheet" />
    <% } %>
    <% if (locals.plugins && locals.plugins.length > 0) { %>
    <%# A deferred plugin's stylesheet is loaded with its code, by the page that draws it. %>
    <% for (const plugin of locals.plugins) { if (plugin.css && !plugin.deferred) { %>
    <link href="<%= plugin.css %>" rel="stylesheet" data-plitzi-plugin="<%= plugin.keyName %>" />
    <% } } %>
    <% } %>
    <%# The icons are a sheet of their own, after the page's own: their fonts are files fetched only for a style a page uses. %>
    <% if (locals.iconsCssPath) { %>
    <link href="<%= locals.iconsCssPath %>" rel="stylesheet" />
    <% } %>

    <% if (!locals.ssrOnly) { %>
    <%#
      The import map before anything that loads a module: a browser that fetched one already (a modulepreload counts)
      ignores a map that comes after it, and the SDK's `import "react"` then resolves to nothing.
    %>
    <script type="importmap"<%- locals.nonce ? ` nonce="${locals.nonce}"` : '' %>>
      {
        "imports": {
          "react": "<%= locals.react || '' %>",
          "react-dom": "<%= locals.reactDom || '' %>",
          "react-dom/client": "<%= locals.reactDomClient || '' %>",
          "react/jsx-runtime": "<%= locals.reactJsx || '' %>",
          "react/compiler-runtime": "<%= locals.reactCompilerRuntime || locals.react || '' %>",
          "@plitzi/plitzi-sdk": "<%= locals.jsPath || '' %>"
        }
      }
    </script>

    <% } %>
  </head>

  <body>
    <noscript>You need to enable JavaScript to run this app.</noscript>
    <div id="plitzi" class="plitzi-root-container"><%- locals.html || '' %></div>
    <%# Seen as soon as it is parsed: views/inline/motionSeen.js says why. %>
    <script<%- locals.nonce ? ` nonce="${locals.nonce}"` : '' %>>
<%- inline('motionSeen.js') %>
    </script>
    <% if (!locals.ssrOnly) { %>
    <%# The payload is data, so it travels as JSON: parsing it as a JavaScript literal cost the browser several times
        what JSON.parse does, on megabytes of it. Escaped by the server — no `<` reaches this block. %>
    <script type="application/json" id="plitzi-ssr-data"><%- locals.offlineData || '{}' %></script>
    <%#
      The SDK, the plugins the page draws and the space's document are asked once the page has PAINTED, not as the
      browser parses it. Hydrating needs them and painting does not, and on a phone's network they are most of what the
      page loads: asked beside the stylesheets, they shared the line with them, and the page painted only when the
      stylesheets got through (the dashboard's space page: 1.58 s, against 1.03 s with nothing beside them). They take
      as long to arrive either way — the network is what they wait for — so the page hydrates when it did, and paints
      half a second sooner. A frame and the task after it is "painted"; a tab nobody sees paints nothing, and starts at
      once. React's vendor file is imported beside the SDK rather than found inside it, a round trip later.
    %>
    <script type="module"<%- locals.nonce ? ` nonce="${locals.nonce}"` : '' %>>
      <% const activePlugins = (locals.plugins || []).filter(p => p.js); %>
      <% const drawnPlugins = activePlugins.filter(p => !p.deferred); %>
      <% const json = value => JSON.stringify(value ?? null).replace(/</g, '\\u003c'); %>
      <%# Taps, sends and typing before React listens, kept and made again: views/inline/keepTaps.js says how. %>
<%- inline('keepTaps.js') %>
      if (document.visibilityState !== 'hidden') {
        await new Promise(resolve => requestAnimationFrame(() => setTimeout(resolve)));
      }

      const __plitziSpaceUrl = <%- json(locals.spaceDocumentPath) %>;
      const __plitziSpaceAsked = __plitziSpaceUrl ? fetch(__plitziSpaceUrl) : undefined;
      const [{ render }<%- drawnPlugins.map(p => `, { default: ${p.varName} }`).join('') %>] = await Promise.all([
        import('<%= locals.jsPath || '' %>'),
        <% for (const plugin of drawnPlugins) { %>
        import('<%= plugin.js %>'),
        <% } %>
        ...<%- json([...new Set([locals.react, locals.reactDom].filter(Boolean))]) %>.map(module => import(module))
      ]);
      <%# What the page draws, imported before it hydrates; the rest declared, and imported when a page draws it. %>
      const __plitziPlugins = { <%- activePlugins.map(p => p.deferred
        ? `'${p.keyName}': {load: () => import('${p.js}'), css: ${json(p.css)}, declaration: ${json(p.deferred)}, props: ${json(p.props)}, clientOnly: ${p.ssr === false}}`
        : `'${p.keyName}': {component: ${p.varName}, props: ${json(p.props)}, clientOnly: ${p.ssr === false}}`).join(', ') %> };
      const __plitziData = document.getElementById('plitzi-ssr-data');
      const __plitziParams = JSON.parse(__plitziData.textContent);
      // Read once: the page would otherwise hold the space twice, as this text and as what it was parsed into.
      __plitziData.remove();
      if (__plitziSpaceAsked) {
        const response = await __plitziSpaceAsked;
        if (!response.ok) {
          throw new Error(`[plitzi] The space could not be loaded (${response.status}): the page stays as the server drew it.`);
        }

        __plitziParams.offlineData = await response.json();
      }
      <% if (locals.livePages) { %>
      __plitziListening();
      const __plitziApp = render('plitzi', __plitziParams, __plitziPlugins, <%= locals.debugMode ? true : false %>, true, { hotPlugins: <%= locals.hotPlugins ? true : false %> });
      // New documents for the space this page shows: swapped where it stands, its state kept. A page that cannot take
      // them in place (one with elements the server draws) loads again.
      window.__plitziLiveEvents?.addEventListener('space', event => {
        const { documents } = JSON.parse(event.data);
        if (!__plitziApp?.replaceSpace(documents)) {
          location.reload();
        }
      });
      // A plugin the server built again: its new bundle swapped in where it is drawn and its stylesheet pointed at the
      // new one — the rest of the page stays as it is. One that cannot be swapped in place loads the page again.
      window.__plitziLiveEvents?.addEventListener('plugin', async event => {
        const { key, js, css } = JSON.parse(event.data);
        const sheet = css && [...document.querySelectorAll('link[data-plitzi-plugin]')].find(link => link.dataset.plitziPlugin === key);
        if (sheet) {
          sheet.href = css;
        }

        try {
          const { default: component } = await import(js);
          if (!__plitziApp?.replacePlugin(key, component)) {
            location.reload();
          }
        } catch (error) {
          console.error(`[plitzi] plugin "${key}" could not be loaded again`, error);
        }
      });
      <% } else { %>
      __plitziListening();
      render('plitzi', __plitziParams, __plitziPlugins, <%= locals.debugMode ? true : false %>, true);
      <% } %>
    </script>
    <% } %>
    <% if (locals.livePages) { %>
    <%# Only with `livePages`: the server says what changed under the page — everything (`reloadPages`), and the page
        loads again, as does a page that reconnects to a server that restarted (a different `boot`): its code changed
        under it. A draft listens for its own changes alone, by its token. %>
    <script<%- locals.nonce ? ` nonce="${locals.nonce}"` : '' %>>
      (() => {
        const events = new EventSource(<%- JSON.stringify(locals.liveDraft ? `/__plitzi/live?__pt=${encodeURIComponent(locals.liveDraft)}` : '/__plitzi/live').replace(/</g, '\\u003c') %>);
        // The page's module script listens here too, for its space (`space`) and a plugin built again (`plugin`).
        window.__plitziLiveEvents = events;
        let boot;
        events.addEventListener('hello', event => {
          const next = JSON.parse(event.data).boot;
          if (boot && boot !== next) {
            location.reload();
          }

          boot = next;
        });
        events.addEventListener('reload', () => location.reload());
      })();
    </script>
    <% } %>
  </body>
</html>
