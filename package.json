{
  "name": "@plitzi/plitzi-workspace",
  "license": "AGPL-3.0",
  "scripts": {
    "start": "turbo start --parallel --filter='!./examples/**' --filter='!./e2e'",
    "start:debug": "turbo start:debug --parallel --concurrency=20",
    "test": "TURBO_RUN=1 turbo test --parallel",
    "test:coverage": "TURBO_RUN=1 turbo test:coverage --parallel --concurrency=20",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "e2e:debug": "playwright test --config e2e/playwright.config.ts --debug",
    "e2e:codegen": "playwright codegen http://127.0.0.1:5100",
    "e2e:list": "playwright test --config e2e/playwright.config.ts --list",
    "e2e:report": "playwright show-report e2e/.artifacts/report",
    "e2e:install": "playwright install chromium",
    "lint": "turbo lint --parallel",
    "lint-style": "turbo lint-style --parallel",
    "lint-style:fix": "turbo lint-style:fix --parallel --concurrency=20",
    "typecheck": "turbo typecheck --parallel",
    "build:dev": "turbo build:dev",
    "build:dev-watch": "turbo build:dev-watch --parallel --concurrency=20",
    "build:dev-measure": "turbo build:dev-measure --parallel --concurrency=20",
    "build:dev-gzip": "turbo build:dev-gzip",
    "build:dev-analyze": "turbo build:dev-analyze --parallel --concurrency=20",
    "build:prod": "turbo build:prod",
    "build:prod-watch": "turbo build:prod-watch --parallel --concurrency=20",
    "build:prod-measure": "turbo build:prod-measure --parallel --concurrency=20",
    "build:prod-gzip": "turbo build:prod-gzip",
    "build:prod-analyze": "turbo build:prod-analyze --parallel --concurrency=20",
    "build-vendor:dev": "turbo build-vendor:dev",
    "build-vendor:prod": "turbo build-vendor:prod",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "changeset": "changeset",
    "generate-tarballs": "yarn workspaces foreach -A --no-private exec yarn pack",
    "check-tgz": "yarn generate-tarballs && bash -c 'for tgz in packages/*/*.tgz apps/*/*.tgz; do echo \"---- $tgz ----\"; if tar -xOzf \"$tgz\" package/package.json | grep -q \"workspace:*\"; then echo \"⚠️  Contiene workspace:*\"; else echo \"✅ No workspace:*\"; fi; done'",
    "ci:publish": "yarn workspaces foreach -A --no-private --topological-dev --exclude . exec yarn npm publish --tolerate-republish --access public && changeset tag"
  },
  "dependencies": {
    "@plitzi/plitzi-ui": "^1.6.20",
    "@plitzi/sdk-shared": "workspace:*",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "eslint": "^9.39.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.9"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.2.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e",
    "examples/shared-space",
    "examples/*/*"
  ]
}
